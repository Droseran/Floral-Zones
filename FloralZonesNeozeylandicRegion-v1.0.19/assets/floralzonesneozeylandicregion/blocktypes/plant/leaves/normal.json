{
    "code": "leaves",
    "__comment": "BlockLeaves contains some code for map color tinting, stuff for wind affectedness and random testForDecay server block ticks",
    "class": "BlockLeaves",
    "behaviorsByType": {
	"*-grown*-*": [{"name": "PushEventOnBlockBroken",	"properties": {"eventname": "testForDecay"}}, { "name": "RainDrip" }],
        "*": [{ "name": "RainDrip" }]
    },
    "attributes": {
        "handbook": {
            "groupBy": ["leaves-*"]
        },
        "treeFellingGroupCodeByType": {
            "*-grown-*": "0{wood}",
            "*-grown1-*": "1{wood}",
            "*-grown2-*": "2{wood}",
            "*-grown3-*": "3{wood}",
            "*-grown4-*": "4{wood}",
            "*-grown5-*": "5{wood}",
            "*-grown6-*": "6{wood}",
            "*-grown7-*": "7{wood}",

	    "*-placed-*": "3{wood}"
        },
        "treeFellingGroupSpreadIndex": 0,
        "canDecayByType": {
            "*-grown*-*": true
        }
    },
    "variantgroups": [
        { "code": "type", "states": ["grown", "grown1", "grown2", "grown3", "grown4", "grown5", "grown6", "grown7", "placed"] },
        { "code": "wood", "states": ["enteleaarborescens","halocarpusbidwillii","podocarpusnivalis","psuedopanaxcrassifolius"], "loadFromProperties": "floralzonesneozeylandicregion:block/wood" }
    ],
    "creativeinventory": { "general": ["leaves-placed-*"], "flora": ["leaves-placed-*"] },
    "shape": {
        "baseByType": {"*-araucariaheterophylla": "block/plant/leaves/normal","*-podocarpusnivalis": "block/plant/leaves/normal","*": "game:block/plant/leaves/normal"},
        "rotateY": 10,
        "alternates": [{ "rotateY": 61 }, { "rotateY": 113 }, { "rotateY": 164 }, { "rotateY": 216 }, { "rotateY": 267 }, { "rotateY": 319 }]
    },
    "lod0Shape": {
        "baseByType": {"*-araucariaheterophylla": "block/plant/leaves/normal-araucariaheterophylla-lod0","*-halocarpusbidwillii": "block/plant/leaves/normal-lod0","*-podocarpusnivalis": "block/plant/leaves/normal-lod0","*": "game:block/plant/leaves/normal-lod0"},
        "rotateY": 10,
        "alternates": [{ "rotateY": 61 }, { "rotateY": 113 }, { "rotateY": 164 }, { "rotateY": 216 }, { "rotateY": 267 }, { "rotateY": 319 }]
    },
    "shapeInventory": { "baseByType": {"*-podocarpusnivalis": "block/plant/leaves/normal","*": "game:block/plant/leaves/normal-lod0" }},
    "renderpass": "OpaqueNoCull",
    "faceCullMode": "CollapseMaterial",
    "blockmaterial": "Leaves",
    "climateColorMapByType": {
        "*-halocarpusbidwillii": "climateDarkerPlantTint",
        "*": "climatePlantTint"
    },
    "seasonColorMapByType": {
			"*-dacrydiumcupressinum": "seasonalNeedles",
			"*-enteleaarborescens": "tropicalKapok",
        "*-halocarpusbidwillii": "seasonalGrass",
			"*-nothofagusmenziesii": "seasonalNeedles",
        "*-podocarpusnivalis": "seasonalNeedles",
        "*-podocarpustotara": "seasonalLarch",
			"*-psuedopanaxcrassifolius": "tropicalKapok",
        "*": "seasonalFoliage"
    },
    "vertexFlags": {
        "zOffset": 4,
        "windMode": "Leaves"
    },

	"texturesByType": {
			"@.*-(halocarpusbidwillii|podocarpusnivalis)": {"largeleaves": { "base": "floralzonesneozeylandicregion:block/plant/leaves/large/{wood}*" },"smallleaves": { "base": "floralzonesneozeylandicregion:block/plant/leaves/small/podocarpustotara*" }},
		"*": {"largeleaves": { "base": "floralzonesneozeylandicregion:block/plant/leaves/large/{wood}*" },"smallleaves": { "base": "floralzonesneozeylandicregion:block/plant/leaves/small/{wood}*" }}
	},
    "sideopaque": {"all": false},
    "sidesolid": {"all": false},
    "sideao": {"all": true},
    "emitSideAo": {"all": false},
    "snowCoverage": true,
    "replaceable": 4000,
    "lightAbsorption": 1,
    "resistance": 0.5,
    "collisionbox": null,
    "drops": [
        {
            "type": "item",
            "code": "floralzonesneozeylandicregion:treeseed-{wood}",
            "quantityByType": {
                "*": { "avg": 0.05, "var": 0 }
            }
        },
        {
            "type": "item",
            "code": "game:stick",
            "quantity": { "avg": 0.02, "var": 0 }
        }
    ],
    "sounds": {
        "break": "game:block/plant",
        "place": "game:block/plant",
        "hit": "game:block/plant",
        "walk": "game:walk/grass",
	      "inside": "game:walk/inside/leafy/bushrustle*"
    },
    "combustibleProps": {
        "burnTemperature": 600,
        "burnDuration": 10
    },
    "materialDensity": 300,
    "heldTpIdleAnimation": "holdbothhandslarge",
    "heldTpUseAnimation": "twohandplaceblock",
    "tpHandTransform": {
        "translation": { "x": -1.23, "y": -0.91, "z": -0.8 },
        "rotation": { "x": -2, "y": 25, "z": -78 },
        "scale": 0.4
    },
    "guiTransform": {
        "scale": 0.8
    },
    "frostable": true
}
