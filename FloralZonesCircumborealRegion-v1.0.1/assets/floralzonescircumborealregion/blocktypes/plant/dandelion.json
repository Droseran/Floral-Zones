{
	"code": "tallplant",
	"class": "BlockReeds",
	"entityClassByType": {
		"*-harvested-*": "Transient"
	},
	"attributes": {
        "butterflyFeedByType": {"*-normal": true},
        "beeFeedByType": {"*-normal": true},
		"transientPropsByType": {
			"*-harvested-*": {
				"convertFrom": "*-harvested-{cover}", 
				"convertTo": "tallplant-{type}-land-normal-{cover}", 
				"inGameHours": "1188",
				"resetBelowTemperature": -6,
				"stopBelowTemperature": 0
			},
			"*-normal-*": {
				"convertFrom": "*-normal-{cover}", 
				"convertTo": "tallplant-{type}-land-fruiting-{cover}", 
				"inGameHours": "96",
				"resetBelowTemperature": -6,
				"stopBelowTemperature": 0
			},
			"*-fruiting-*": {
				"convertFrom": "*-fruiting-{cover}", 
				"convertTo": "tallplant-{type}-land-empty-{cover}", 
				"inGameHours": "192",
				"resetBelowTemperature": -6,
				"stopBelowTemperature": 0
			}
		},
		"maxWaterDepthByType": {
			"tallplant-*": 0
		}
	},
	"allowedVariants": [ 
		"*-land-*" 
	],
	"variantgroups": [
		{ "code": "type", "states": ["taraxacumofficinale"] },
		{ "code": "habitat", "states": ["land"] },
		{ "code": "state", "states": ["normal", "harvested"] },
		{ "code": "cover", "states": ["free", "snow"] }
	],
	"creativeinventory": { 
		"general": ["*-land-normal-free"], 
		"flora": ["*-land-normal-free"] 
	},
	"shapeByType": {
		"*-harvested-*":{"base": "block/plant/flower/{type}*",
			"selectiveElements": [ "origin" ] },
		"*-taraxacumofficinale-*":{"base": "block/plant/flower/{type}*" }
	},
	"drawtypeByType": {
		"*-snow": "JSONAndSnowLayer",
		"*": "JSON"
	},
	"renderpass": "OpaqueNoCull",
	"matterstate": "solid",
	"blockmaterial": "plant",
	"faceCullMode": "NeverCull",
	"randomDrawOffset": true,
	"randomizeRotations": true,
	"texturesByType": {
		"*": {
			"flower1": { "base": "block/plant/flower/petal/{type}2","alternates": [ { "base": "block/plant/flower/petal/{type}1"},{ "base": "block/plant/flower/petal/{type}3"},{ "base": "block/plant/flower/petal/{type}1"},{ "base": "block/plant/flower/petal/{type}2"},{ "base": "block/plant/flower/petal/{type}3"} ] },
			"flower2": { "base": "block/plant/flower/petal/{type}1","alternates": [ { "base": "block/plant/flower/petal/{type}3"},{ "base": "block/plant/flower/petal/{type}2"},{ "base": "block/plant/flower/petal/{type}1"},{ "base": "block/plant/flower/petal/{type}2"},{ "base": "block/plant/flower/petal/{type}3"} ] },
			"leaves1": { "base": "block/plant/flower/stem/{type}1","alternates": [ { "base": "block/plant/flower/stem/{type}2"},{ "base": "block/plant/flower/stem/{type}2"},{ "base": "block/plant/flower/stem/{type}1"} ] },
			"leaves2": { "base": "block/plant/flower/stem/{type}2","alternates": [ { "base": "block/plant/flower/stem/{type}1"},{ "base": "block/plant/flower/stem/{type}2"},{ "base": "block/plant/flower/stem/{type}1"} ] }
		}
	},
	"randomSizeAdjust": 0.1,
	"sideopaqueByType": {
		"*-snow": { "all": false, "down": true },
		"*": { "all": false }
	},
	"sidesolid": { "all" : false },
	"emitsideao": { "all": false },
	"sideao": { "all": true },
	"replaceable": 3000,
	"lightAbsorption": 0,
	"resistance": 1,
	"collisionbox": null,
	"selectionboxByType": {
		"*-harvested-*":{
		"x1": 0.1, "y1": 0, "z1": 0.1,
		"x2": 0.9, "y2": 0.05, "z2": 0.9
	},"*":{
		"x1": 0.1, "y1": 0, "z1": 0.1,
		"x2": 0.9, "y2": 0.25, "z2": 0.9
	}},
	"guitransform": {
		"rotation": { "x": 0, "y": 0, "z": 0 }
	},
	"sounds": {
		"place": "game:block/plant",
		"break": "game:block/plant",
		"hit": "game:block/plant",
		"walk": "game:walk/grass",
  	"inside": "game:walk/grass"
	},
	"rainPermeableByType": {
		"*-land-*": true
	},
	"materialDensity": 200,
	"frostable": true,
	"combustibleProps": {
		"burnTemperature": 600,
		"burnDuration": 10
	},
	"guiTransform": {
		"translation": { "x": 0, "y": -1.5, "z": 0 },
		"rotation": { "x": 0, "y": 0, "z": 0 },
		"origin": { "x": 0.5, "y": 0.4, "z": 0.5 },
		"scale": 1.2
	},
	"dropsByType": {
	"*-taraxacumofficinale-*-harvested-*": [{ "type": "block", "code": "tallplant-taraxacumofficinale-land-harvested-free" }],
		"*-taraxacumofficinale-*-normal-*": [ { "type": "item", "code": "vegetable-taraxacumofficinale", "quantity": { "avg": 1.4 }}]
	}
}